generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  excerpt   String
  content   String
  image     String   @default("/cover.png")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
